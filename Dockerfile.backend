FROM python:3.11-slim

WORKDIR /app

# Build tools for faiss-cpu wheels on slim images
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (layer cache)
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[dev]"

# Copy source (src/.env is excluded by .dockerignore; compose passes it as env_file)
COPY src/ ./src/

EXPOSE 8000

ENV API_HOST=0.0.0.0 \
    API_PORT=8000 \
    INTERVIEWS_DIR=/app/interviews

CMD ["python", "src/app.py"]
